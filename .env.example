# --- Telegram ---
# Токен від @BotFather (створи бота, назви "Матюкливий гномик")
TELEGRAM_BOT_TOKEN=123456:AAAA-your-token-here

# Груповий чат команди, куди гномик шле ВСІ нагадування, тегаючи людину.
# Додай бота в групу, напиши там щось, і візьми chat_id з getUpdates (див. README).
# Без цього бот працюватиме як раніше — особистими повідомленнями, без тегів.
TEAM_CHAT_ID=

# --- Notion ---
# Створи інтеграцію на https://www.notion.so/my-integrations, скопіюй "Internal Integration Secret"
NOTION_TOKEN=secret_your-notion-token
# ID бази даних (частина URL бази між останнім "/" і "?v=")
NOTION_DATABASE_ID=your-database-id

# --- Назви колонок у Notion (зміни, якщо у тебе інші назви) ---
NOTION_PROP_TASK=Завдання
NOTION_PROP_STATUS=Статус
NOTION_PROP_ASSIGNEE=Відповідальний
NOTION_PROP_DEADLINE=Дедлайн
NOTION_PROP_PILLAR=Зона/пілон

# Статуси, які бот вважає "завершено" (через кому, без пробілів навколо коми)
NOTION_DONE_STATUSES=Готово,Опубліковано
# Статуси, які бот вважає "ще не почато" — саме на них реагує нагадування
# "2 дні до дедлайну, а віз і нині там"
NOTION_NOT_STARTED_STATUSES=Заплановано,Не почато
# Усі можливі статуси для кнопок перемикання в /tasks
NOTION_STATUS_OPTIONS=Заплановано,В роботі,На перевірці,Готово

# --- Розклад ---
TIMEZONE=Europe/Kyiv
# О 10:00 щодня — список тасок людини на поточний тиждень (пн–нд)
DAILY_DIGEST_HOUR=10
DAILY_DIGEST_MINUTE=0
# Через скільки хвилин після дайджесту перевіряти "2 дні / 1 день до дедлайну"
DEADLINE_WATCH_MINUTE_OFFSET=5
NAG_INTERVAL_HOURS=3
WORKDAY_START_HOUR=9
WORKDAY_END_HOUR=21

# --- Токсичність (поки що реалізовано тільки 1) ---
SPICE_LEVEL=1

USERS_FILE=users.json

# --- Двосторонній зв'язок з Notion (Notion -> бот, вебхук) ---
# Опційно. Без цього бот все одно повністю робочий — просто дізнається
# про зміни в Notion під час планових перевірок, а не миттєво.
# PORT підставляє хостинг (Railway/Render) автоматично, локально можна лишити 8080.
PORT=8080
NOTION_WEBHOOK_PATH=/notion-webhook
# Значення verification_token, яке Notion видасть один раз при підключенні
# вебхука — див. README, розділ "Двосторонній зв'язок".
NOTION_WEBHOOK_SECRET=

